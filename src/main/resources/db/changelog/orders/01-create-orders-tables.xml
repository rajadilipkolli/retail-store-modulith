<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="createTable-orders" author="rajakolli">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="orders" tableName="orders"/>
            </not>
        </preConditions>

        <createTable schemaName="orders" tableName="orders">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_orders"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_address_line1" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_address_line2" type="VARCHAR(255)"/>
            <column name="delivery_address_city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_address_state" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_address_zip_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_address_country" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="NUMERIC(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="SMALLINT" defaultValueNumeric="0"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMPTZ"/>
            <column name="last_modified_by" type="VARCHAR(255)"/>
            <column name="last_modified_date" type="TIMESTAMPTZ"/>
        </createTable>

        <createIndex schemaName="orders" tableName="orders" indexName="idx_orders_customer_id">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="createTable-order_items" author="rajakolli">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="orders" tableName="order_items"/>
            </not>
        </preConditions>

        <createTable schemaName="orders" tableName="order_items">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_order_items"/>
            </column>
            <column name="product_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="product_price" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex schemaName="orders" tableName="order_items" indexName="idx_order_items_order_id">
            <column name="order_id"/>
        </createIndex>

        <addForeignKeyConstraint baseTableSchemaName="orders" baseTableName="order_items"
                                 baseColumnNames="order_id"
                                 constraintName="fk_order_items_on_order"
                                 referencedTableSchemaName="orders"
                                 referencedTableName="orders"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addUniqueConstraint schemaName="orders" tableName="order_items"
                             columnNames="product_code, order_id"
                             constraintName="uc_order_items_product_order"/>
    </changeSet>

</databaseChangeLog>
