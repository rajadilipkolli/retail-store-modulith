<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="createTable-payment_operations" author="rajakolli">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="payment" tableName="payment_operations"/>
            </not>
        </preConditions>
        <createTable schemaName="payment" tableName="payment_operations">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_payment_operations" nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_payment_ops_idempotency_key"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_payment_ops_customer" references="payment.customers(id)"/>
            </column>
            <column name="operation_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="SMALLINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex schemaName="payment" tableName="payment_operations" indexName="idx_payment_ops_order_id">
            <column name="order_id"/>
        </createIndex>

        <createIndex schemaName="payment" tableName="payment_operations" indexName="idx_payment_ops_customer_id">
            <column name="customer_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-payment_operations-check-constraints" author="rajakolli">
        <sql>
            ALTER TABLE payment.payment_operations ADD CONSTRAINT chk_payment_ops_amount CHECK (amount > 0);
        </sql>
    </changeSet>

</databaseChangeLog>
