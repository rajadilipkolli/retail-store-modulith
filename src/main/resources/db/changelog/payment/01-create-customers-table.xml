<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="createTable-customers" author="rajakolli">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="payment" tableName="customers"/>
            </not>
        </preConditions>
        <createTable schemaName="payment" tableName="customers">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_customers" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uc_customers_email"/>
            </column>
            <column name="phone" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line1" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="address_line2" type="VARCHAR(255)"/>
            <column name="city" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="zip_code" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount_available" type="NUMERIC(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="amount_reserved" type="NUMERIC(19,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="add-customers-balance-check-constraints" author="rajakolli">
        <sql>
            ALTER TABLE payment.customers ADD CONSTRAINT chk_customers_amount_available CHECK (amount_available >= 0);
            ALTER TABLE payment.customers ADD CONSTRAINT chk_customers_amount_reserved CHECK (amount_reserved >= 0);
        </sql>
    </changeSet>

</databaseChangeLog>
